# LifeQuest Environment Variables
SECRET_KEY=your-random-secret-key-here
DATABASE_URL=sqlite:///./lifequest.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,https://localhost,capacitor://localhost

# MCP Server (supervisor runs one instance on internal port 3001, proxied via /mcp/http (Streamable HTTP) and /mcp/sse (legacy))
MCP_PORT=3001
# LIFEQUEST_MCP_SERVICE_USER_ID=  — optional consistency check only; requires a valid LIFEQUEST_MCP_TOKEN and does not grant access by itself
# LIFEQUEST_MCP_TOKEN=  — optional stdio MCP access token; keep the value secret and out of version control
LIFEQUEST_MCP_TOKEN=

# Optional MCP OAuth authorization server. Disabled until HTTPS public URLs are configured.
MCP_OAUTH_ENABLED=false
# Issuer is the public LifeQuest API origin; never derive it from request Host headers.
MCP_OAUTH_ISSUER_URL=https://life.capkin.cn
MCP_OAUTH_RESOURCE_URL=https://life.capkin.cn/mcp/http
MCP_OAUTH_FRONTEND_URL=https://life.capkin.cn
# Development only: permit HTTP loopback redirect/public URLs. Keep false on public servers.
MCP_OAUTH_ALLOW_LOOPBACK=false
