{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeQuest",
  "version": "1.14.8",
  "identifier": "com.lifequest.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LifeQuest",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000 http://127.0.0.1:8000 ws://localhost:3000 ws://127.0.0.1:8000; connect-src 'self' https: http://localhost:3000 http://127.0.0.1:8000 ws://localhost:3000 ws://127.0.0.1:8000 wss:; img-src 'self' data: blob: https: http://localhost:3000 http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      }
    }
  }
}
